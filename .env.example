# Template for secret keys. Copy this file to `.env` and fill in values.
# `.env` is ignored by git, so your real keys never get uploaded.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# --- Login sessions ---
# Signs login cookies. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Neon (Postgres database) ---
# The site prefers DATABASE_URL_POOLED (host has "-pooler"); migrations prefer DATABASE_URL_UNPOOLED.
# Either way, DATABASE_URL alone works too.
DATABASE_URL=
DATABASE_URL_POOLED=

# --- Cloudflare R2 (image/file storage) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_TOKEN=
CLOUDFLARE_PUBLIC_URL=

# --- Resend (email) ---
RESEND_API_KEY=

# --- Google sign-in (Auth.js) ---
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
